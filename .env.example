# Copy to `.env` to switch Directorr off the local mock backend.
#
# BOTH values are public-safe: the Supabase anon/publishable key is designed to
# be shipped to browsers. RLS (see docs/SETUP-SUPABASE.md) is the security
# boundary. NEVER put the service_role key here.
#
# Leave this file empty and the app keeps using the localStorage mock backend.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OPTIONAL — stock-provider search (Pexels/Pixabay) via the stock-search edge
# function. This is only an endpoint URL, so it is not a secret; the provider API
# keys themselves live in `supabase secrets set`, never here. Leave blank and the
# picker still works through the studio library, uploads, and pasted URLs.
#
#   supabase functions deploy stock-search --no-verify-jwt
#   supabase secrets set PEXELS_API_KEY=... PIXABAY_API_KEY=...
#   VITE_STOCK_SEARCH_ENDPOINT=https://<project-ref>.supabase.co/functions/v1/stock-search
#
# See docs/SETUP-BROLL.md.
VITE_STOCK_SEARCH_ENDPOINT=
