# Copy to `.env` to switch Directorr off the local mock backend.
#
# BOTH values are public-safe: the Supabase anon/publishable key is designed to
# be shipped to browsers. RLS (see docs/SETUP-SUPABASE.md) is the security
# boundary. NEVER put the service_role key here.
#
# Leave this file empty and the app keeps using the localStorage mock backend.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
